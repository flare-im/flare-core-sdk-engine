{
  "schemaVersion": 1,
  "eventContractVersion": "flare-im-events/v2",
  "rules": [
    "Rust core SdkEvent is the source of truth.",
    "C ABI event_json uses camelCase SDK JSON fields and always includes type and event.",
    "C ABI numeric event_type callback parameter is stable and must be used for fast native dispatch.",
    "Tauri emits im://* names with camelCase SDK JSON payloads; the single connection event is connection://status and access events are access://switched / access://changed.",
    "Connection state has exactly one event (connection.status): kicked / token expiry are its actionRequired phase, not separate events.",
    "Notification events are separate from chat message events.",
    "Extension payload bytes are opaque and interpreted by the owning extension."
  ],
  "cAbi": {
    "subscribe": "flare_event_subscribe(handle, context, callback)",
    "subscribeBatch": "flare_event_subscribe_batch(handle, context, callback)",
    "unsubscribe": "flare_event_unsubscribe(subscription)",
    "callback": "extern C fn(context, event_type: i32, event_json: FlareString)",
    "batchCallback": "extern C fn(context, event_count: usize, events_json: FlareString)",
    "batchJson": {
      "events": [
        {
          "eventType": "i32",
          "payload": "same object as the single-event event_json payload"
        }
      ]
    },
    "codeRanges": {
      "connection": "1001-1999",
      "message": "2001-2999",
      "conversation": "3001-3499",
      "notification": "3501-3999",
      "sync": "4001-4999",
      "extension": "5001-5999",
      "view": "6001-6999",
      "plugin": "7001-7999"
    }
  },
  "events": [
